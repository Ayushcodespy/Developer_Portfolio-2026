# ==============================================================================
# Backend Environment Configuration Example
# Copy this file to .env and replace placeholder values with your real configuration.
# DO NOT commit real secrets or production credentials to Git.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Database Connection URL
# For local SQLite development:
DATABASE_URL=sqlite:///./portfolio.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://username:password@localhost:5432/portfolio_db

# Security & Session Secrets
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-minimum
JWT_SECRET=replace-with-a-secure-random-jwt-secret-key-32-chars-minimum
ADMIN_SESSION_MINUTES=480
COOKIE_SECURE=false

# URLs & CORS Origins
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
PORTFOLIO_URL=https://ayushcodespy.vercel.app
RESUME_URL=https://drive.google.com/file/d/your-resume-id/view?usp=sharing

# Initial Administrator Bootstrap Credentials (used by create_admin.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# SMTP Email Configuration (Optional - for real email dispatch)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-smtp-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Ayush Patel Portfolio
SMTP_USE_TLS=true
CONTACT_RECEIVER_EMAIL=your-email@gmail.com
