# ==============================================================================
# Portfolio Environment Configuration Example
# Copy this file to .env and replace placeholders with your own settings.
# Never commit real credentials or production secrets to Git.
# ==============================================================================

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Backend Configuration
ENVIRONMENT=development
DATABASE_URL=sqlite:///./portfolio.db
# DATABASE_URL=postgresql://username:password@localhost:5432/portfolio_db
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-minimum
JWT_SECRET=replace-with-a-secure-random-jwt-secret-key-32-chars-minimum
ADMIN_SESSION_MINUTES=480
COOKIE_SECURE=false

# URLs & Domains
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
PORTFOLIO_URL=https://ayushcodespy.vercel.app
RESUME_URL=https://drive.google.com/file/d/your-resume-id/view?usp=sharing

# Admin Bootstrap Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Ayush Patel Portfolio
SMTP_USE_TLS=true
CONTACT_RECEIVER_EMAIL=your-email@gmail.com
